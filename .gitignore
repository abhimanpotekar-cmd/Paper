# Secrets
.env
.env.*
!.env.example

# Virtual environments
.venv/
venv/

# Python cache
__pycache__/
*.pyc
.pytest_cache/

# IDE settings
.idea/
.vscode/

# Generated files
*.log

# Ignore one file
private_notes.txt

# Ignore an entire folder
local_data/

/settings.py

# Ignore specific docx files (or all docx files)
inputs/paper.docx
templates/template.docx
# Alternatively, to ignore any .docx file anywhere:
# *.docx

# Ignore all generated contents inside outputs, but keep the folder and its __init__.py
outputs/*
!outputs/__init__.py